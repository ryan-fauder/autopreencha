{
  "manifest_version": 3,
  "name": "Autopreencha – Gerador de dados fictícios",
  "short_name": "Autopreencha",
  "version": "1.3.0",
  "description": "Preenche formulários com dados fictícios válidos: CPF, CNPJ, RG, CNH, PIS, CNS, IE, cartão, placa, endereço e mais.",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Autopreencha",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "sidebar_action": {
    "default_title": "Autopreencha",
    "default_panel": "popup/popup.html?view=sidebar",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "lib/data.js",
      "lib/generators.js",
      "lib/fill.js",
      "background.js"
    ]
  },
  "permissions": [
    "menus",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Autopreencher o formulário da página com dados fictícios"
    },
    "_execute_sidebar_action": {
      "description": "Abrir/fechar o Autopreencha na barra lateral"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autopreencha@ryanfauder",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
